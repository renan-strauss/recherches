@article{perennes_universites_nodate,
	title = {Universités et insertion professionnelle des étudiants : jusqu'où l'université peut-elle et doit-elle s'engager ?},
	abstract = {University structures are now committed to implementing multiple measures to support students in their employability. After tracing the evolution of the relationship between education and employment in recent decades, this section will build on supports implemented at the University of South Brittany and present how it prepares its students for future employability. Finally, the point of view of students and teachers will facilitate debate on the issue of the positioning of the university in this process and its commitments.},
