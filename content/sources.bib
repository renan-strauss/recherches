	author = {Pérennès, Laurence},
	file = {PDF:/Users/renan/Zotero/storage/BKTBPDSU/Pérennès - Universités et insertion professionnelle des étudiants  jusqu'où l'université peut-elle et doit-ell.pdf:application/pdf},
